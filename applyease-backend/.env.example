# ─── PostgreSQL / Supabase ────────────────────────────────────────────────────
# Local dev : laisse les valeurs par défaut (localhost).
# Production : utilise les valeurs du projet Supabase
#   (Settings → Database → Connection string → mode "Session").

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=applyease

# Supabase : remplace par quelque chose comme :
# PGHOST=db.<project-ref>.supabase.co
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=<ton-mot-de-passe-supabase>
# PGDATABASE=postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Génère une clé forte en prod : python -c "import secrets; print(secrets.token_hex(32))"
JWT_KEY=dev-secret-change-me-in-production
JWT_EXPIRES_IN_MIN=60

# ─── LLM (optionnel — pour la génération de cover letters) ───────────────────
OPENAI_API_KEY=
# LLM_PROVIDER=openai   # ollama | lmstudio | openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=         # Laisser vide pour OpenAI, sinon URL du serveur local

# ─── Frontend ────────────────────────────────────────────────────────────────
# Dans frontend/.env (Vercel : variable d'env dans le dashboard)
# REACT_APP_API_BASE=https://your-backend.railway.app
